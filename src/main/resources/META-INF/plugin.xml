<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.maytman.intellir</id>
    <name>IntelliR</name>
    <vendor>maytman</vendor>
    <description><![CDATA[
        <p><b>IntelliR</b> is a plugin that implements revo support in JetBrains IDEs</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Revo"
                implementationClass="com.github.maytman.intellir.revo.RevoFileType"
                fieldName="INSTANCE"
                language="Revo"
                extensions="rv"/>
        <platform.lsp.serverSupportProvider
                implementation="com.github.maytman.intellir.revo.lsp.RevoLspIntegration"/>
        <lang.parserDefinition
                language="Revo"
                implementationClass="com.github.maytman.intellir.revo.psi.RevoParserDefinition"/>
        <lang.commenter
                language="Revo"
                implementationClass="com.github.maytman.intellir.revo.editor.RevoCommenter"/>
        <internalFileTemplate name="RevoTemplate"/>
        <applicationService
                serviceImplementation="com.github.maytman.intellir.revo.editor.settings.RevoSettings"/>
        <applicationConfigurable
                parentId="tools"
                instance="com.github.maytman.intellir.revo.editor.settings.RevoSettingsConfigurable"
                id="com.github.maytman.intellir.revo.editor.settings.RevoSettingsConfigurable"
                displayName="Revo"/>
        <configurationType
                implementation="com.github.maytman.intellir.revo.editor.runConfiguration.RevoRunConfigurationType"/>
        <runConfigurationProducer
                implementation="com.github.maytman.intellir.revo.editor.runConfiguration.RevoRunConfigurationProducer"/>
    </extensions>

    <actions>
        <action
                id="com.github.maytman.intellir.revo.editor.fileTemplate.CreateRevoFileAction"
                class="com.github.maytman.intellir.revo.editor.fileTemplate.CreateRevoFileAction"
                text="Revo File"
                icon="/icons/revo.png">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>
